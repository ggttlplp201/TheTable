{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Player-visible UI observation",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "playerId": {
      "type": "string",
      "enum": [
        "a",
        "b",
        "c",
        "d"
      ]
    },
    "capturedAt": {
      "type": "string",
      "format": "date-time"
    },
    "url": {
      "type": "string",
      "format": "uri"
    },
    "title": {
      "type": "string"
    },
    "text": {
      "type": "string"
    },
    "round": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "phase": {
      "enum": [
        "entry",
        "lobby",
        "setup",
        "playing",
        "spectator",
        "results"
      ]
    },
    "controls": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "button",
              "textbox",
              "select",
              "checkbox",
              "radio",
              "link"
            ]
          },
          "enabled": {
            "type": "boolean"
          },
          "value": {
            "type": "string"
          },
          "options": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "role",
          "name",
          "kind",
          "enabled"
        ]
      }
    },
    "visibleEvents": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "sequence": {
            "type": "integer",
            "minimum": 0
          },
          "text": {
            "type": "string"
          }
        },
        "required": [
          "sequence",
          "text"
        ]
      }
    },
    "screenshotPath": {
      "type": "string"
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Visible rendered alert text only; empty at spectator/results boundaries."
    }
  },
  "required": [
    "id",
    "playerId",
    "capturedAt",
    "url",
    "title",
    "text",
    "round",
    "phase",
    "controls",
    "visibleEvents"
  ]
}
