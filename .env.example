# Copy to .env for deployment/compose.yaml. Use the exact public browser
# origin(s), including scheme and port when non-default, with no path or
# trailing slash. Separate multiple origins with commas.
CLIENT_ORIGIN=https://table.example.com

# Browser voice is opt-in and disabled by default. When enabled without a TURN
# entry, the UI explicitly reports direct-only connectivity (which can fail on
# restrictive networks). JSON entries accept only stun/stuns/turn/turns URLs;
# TURN entries require username and credential. Do not commit real credentials.
VOICE_ENABLED=false
# VOICE_ICE_SERVERS=[{"urls":"stun:stun.example.net:3478"},{"urls":"turns:relay.example.net:5349?transport=tcp","username":"replace-me","credential":"replace-me"}]
VOICE_ICE_SERVERS=[]

# Host port published by the Compose reference deployment.
TABLE_PORT=3001
